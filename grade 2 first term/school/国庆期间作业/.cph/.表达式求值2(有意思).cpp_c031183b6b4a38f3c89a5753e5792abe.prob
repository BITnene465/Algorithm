{"name":"Local: 表达式求值2(有意思)","url":"f:\\CPPstudy\\grade 2 first term\\school\\国庆期间\\表达式求值2(有意思).cpp","tests":[{"id":1696268962818,"input":"abc=10\ndef=8\nc=abc+def\nabc=abc+5-c*2\n? c\n? abc\nend","output":"c=18\nabc=-21"},{"id":1696268977587,"input":"a=12\nb=5\nc=a/b\nd=(a+1)%(b+1)\ne=a^2\nf=-12+a\ng=(a+5)*d-c\n? c\n? d\n? e\n? f\n? g\na=a+10\n? a\nend","output":"c=2\nd=1\ne=144\nf=0\ng=15\na=22"},{"id":1696268995587,"input":"abc=3\nab=2^(abc-1)^(5-abc)\n? ab\nend","output":"ab=16"},{"id":1696271582612,"input":"a=2\n? a\nend","output":"a=2"},{"id":1696271591464,"input":"a=2\nb=a^(a+1)^(10-8)\n? b\nend","output":"b=512"},{"id":1696271640338,"input":"a=10\n? a\nb=-10+10\n? b\na=-10-10\n? a\nc=a+-10+-10\n? c\nd=-20+-8-8\n? d\ne=a-12*-2\n? e\nf=80--10+2\n? f\ng=-10--10\n? g\nh=-10+-10\n? h\ni=(90)\n? i\nk=(-100)\n? k\nend","output":"a=10\nb=0\na=-20\nc=-40\nd=-36\ne=4\nf=92\ng=0\nh=-20\ni=90\nk=-100"},{"id":1696271663504,"input":"abcdefgh=4\nten=10\na=18-32\n? a\nb=18/abcdefgh\n? b\nc=18%(b-1)\n? c\nd=ten+(ten+ten)*abcdefgh\n? d\ne=ten-2*ten/abcdefgh\n? e\nf=(18-3)*3\n? f\nten=ten*(ten)\n? ten\nten=ten/10\nten=(ten+2)/(8-ten)\n? ten\nh=(2*3)/(5*2)\n? h\nten=10\nx=ten-(80-30)/3*3+abcdefgh\ny=(((2+8)*2-(2+abcdefgh)/2)*2-8)*2\nz=(((8+2)*(abcdefgh/2)))\n? x\n? y\n? z\nend","output":"a=-14\nb=4\nc=0\nd=90\ne=5\nf=45\nten=100\nten=-6\nh=0\nx=-34\ny=52\nz=20"}],"interactive":false,"memoryLimit":1024,"timeLimit":3000,"srcPath":"f:\\CPPstudy\\grade 2 first term\\school\\国庆期间\\表达式求值2(有意思).cpp","group":"local","local":true}