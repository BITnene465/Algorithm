{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件",
            "options": {
                "cwd": "${fileDirname}"
            },
            "command": "F:\\VScode\\mingw64\\bin\\g++.exe",    //此处用g++生成文件, 不要用 gdb
            "args": [
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "problemMatcher": [
                "$gcc"     // 这里仍然是 gcc
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ],
}